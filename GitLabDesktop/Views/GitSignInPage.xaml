<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitLabDesktop.ViewModels"
             x:Class="GitLabDesktop.Views.GitSignInPage"
             x:DataType="vm:GitSignInViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaneLight}, Dark={StaticResource PaneDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10" MaximumWidthRequest="560" VerticalOptions="Center">
            <Label Text="{Binding Heading}" Style="{StaticResource DialogTitle}" />
            <Label Text="{Binding Message}" />
            <Label Text="{Binding GitError}" Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}"
                   MaxLines="4" LineBreakMode="TailTruncation" />

            <Label Text="Username" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
            <Entry Text="{Binding UserName}" Placeholder="Username" />

            <Label Text="Password or access token" Style="{StaticResource SecondaryText}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="SecretEntry" Text="{Binding Secret}" IsPassword="True" Placeholder="Password or token"
                       ReturnCommand="{Binding SignInCommand}" />
                <Button Grid.Column="1" Text="Create token…" Command="{Binding CreateTokenCommand}" IsVisible="{Binding CanCreateToken}"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>
            <Label Text="{Binding SecretHelp}" Style="{StaticResource SecondaryText}" />

            <VerticalStackLayout Spacing="0" Margin="0,6,0,0" IsVisible="{Binding HasRepositoryName}">
                <Label Text="Use this sign-in for" Style="{StaticResource SecondaryText}" />
                <RadioButton Content="{Binding AllRepositoriesText}" IsChecked="{Binding ForAllRepositories}" GroupName="scope" />
                <RadioButton Content="{Binding ThisRepositoryText}" IsChecked="{Binding ForThisRepository}" GroupName="scope" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="Auto,*">
                <CheckBox IsChecked="{Binding Remember}" />
                <Label Grid.Column="1" Text="Remember on this computer (stored in secure storage)" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding CanUseForApi}">
                <CheckBox IsChecked="{Binding UseForApi}" />
                <Label Grid.Column="1" Text="{Binding UseForApiText}" VerticalOptions="Center" />
            </Grid>

            <Label Text="{Binding Error}" TextColor="{StaticResource KindDeleted}"
                   IsVisible="{Binding Error, Converter={StaticResource IsNotNullOrEmpty}}" />

            <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Margin="0,8,0,0">
                <Button Text="Cancel" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Text="Sign in" Command="{Binding SignInCommand}" FontAttributes="Bold" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
